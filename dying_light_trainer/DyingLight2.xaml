<Window x:Class="dying_light_trainer.DyingLight2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dying_light_trainer"
        mc:Ignorable="d"
            Title="Dying Light 2 Trainer" Height="300" Width="400" Background="#1E1E1E">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Dying Light 2 External Trainer" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBlock x:Name="lblStatus" Text="Status: Waiting for game..." Foreground="Gray" Margin="0,0,0,20"/>

            <Button Content="Inventory manager" Width="150" Click="OpenInventoryManager" HorizontalAlignment="Left" Margin="2, 10, 0, 0" FontSize="14" FontWeight="bold"></Button>

            <!-- This matches the lblStatus used in your C# code -->
        </StackPanel>
    </Grid>
</Window>
