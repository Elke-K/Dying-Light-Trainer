<Window x:Class="dying_light_trainer.ChoiceMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dying_light_trainer"
        mc:Ignorable="d"
        Title="Dying Light Games AIO Trainer" Height="320" Width="400" 
        Background="#1E1E1E" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- Dark modern button style with Dying Light orange accent -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderBrush" Value="#E65100"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E65100"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="SELECT GAME" Foreground="#E65100" FontSize="16" 
                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Button Content="Dying Light 1" Click="OpenDyingLight1"/>
            <Button Content="Dying Light 2" Click="OpenDyingLight2"/>
            <Button Content="Dying Light The Beast" Click="OpenDyingLightTheBeast"/>
        </StackPanel>
    </Grid>
</Window>